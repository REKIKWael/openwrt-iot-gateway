#!/bin/sh /etc/rc.common
# Script d'init procd du demon iotd

START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled

    config_load iotd
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    procd_open_instance
    procd_set_param command /usr/bin/iotd
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/config/iotd
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "iotd"
}
